# 複製本檔改名為 .env 後填入自己的值。.env 已被 .gitignore 排除。
# 等號兩邊不要空格，值不要加引號。

# ===== LLM 供應商：gemini / groq / anthropic / ollama / none =====
LLM_PROVIDER=gemini

# gemini：免費、免信用卡。到 aistudio.google.com 點 Get API key
GEMINI_API_KEY=貼上你的金鑰
# 可用逗號列多個型號，前面的塞車時自動換下一個
GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest

# groq：免費、免信用卡、速度快。到 console.groq.com 申請
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# anthropic：付費，需先在 console.anthropic.com 儲值
# ANTHROPIC_API_KEY=sk-ant-api03-...

# ollama：本機執行，免費無額度限制但吃顯卡。先安裝 Ollama 並 ollama pull qwen3:8b
# OLLAMA_MODEL=qwen3:8b

# ===== Gmail 寄信（免費）=====
# 應用程式密碼要先開啟兩步驟驗證才能申請，16 碼中間的空格可留可不留
GMAIL_USER=你的帳號@gmail.com
GMAIL_APP_PASSWORD=十六碼應用程式密碼
MAIL_TO=你的帳號@gmail.com

# ===== 選用 =====
# BATCH_SIZE=6          # 每次 LLM 呼叫分析幾則
# GEMINI_GAP=6.5        # Gemini 呼叫間隔秒數，一直撞 429 就調大
# BODY_CHARS=1200       # 每則送給模型的內文字數，額度緊就調小
# TOKENS_PER_ITEM=1100  # 每則的輸出上限，回應被截斷就調大
# GEMINI_THINKING_BUDGET=0  # 模型內部推理預算，設 off 則不送這個參數
# CRAWLER_UA=TechNewsBot/1.0 (personal research; contact: 你的信箱)
# NEWS_DB=news.db
